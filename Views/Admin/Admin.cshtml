@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-950">Panel de Administración</h1>
        <p class="mt-2 text-slate-600">Gestiona usuarios, propiedades y configuración del sistema.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-[16px] bg-[#fde3e8] text-[#b41531]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16 11C17.66 11 18.99 9.66 18.99 8C18.99 6.34 17.66 5 16 5C14.34 5 13 6.34 13 8C13 9.66 14.34 11 16 11ZM8 11C9.66 11 10.99 9.66 10.99 8C10.99 6.34 9.66 5 8 5C6.34 5 5 6.34 5 8C5 9.66 6.34 11 8 11ZM8 13C5.67 13 1 14.17 1 16.5V19H15V16.5C15 14.17 10.33 13 8 13ZM16 13C15.71 13 15.38 13.02 15.03 13.05C15.91 13.79 16.5 14.76 16.5 15.75V17.5H23V15.75C23 13.83 19.67 13 16 13Z" />
                </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-slate-950">Usuarios</h3>
            <p class="mt-2 text-sm text-slate-600">Administra los usuarios registrados en la plataforma.</p>
        </div>

        <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-[16px] bg-[#fde3e8] text-[#b41531]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM9 17H7V10H9V17ZM13 17H11V7H13V17ZM17 17H15V12H17V17Z" />
                </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-slate-950">Propiedades</h3>
            <p class="mt-2 text-sm text-slate-600">Revisa y gestiona todas las propiedades del sistema.</p>
        </div>

        <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-[16px] bg-[#fde3e8] text-[#b41531]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM13 17H11V10H13V17ZM11.5 8.5C10.67 8.5 10 7.83 10 7C10 6.17 10.67 5.5 11.5 5.5C12.33 5.5 13 6.17 13 7C13 7.83 12.33 8.5 11.5 8.5Z" />
                </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-slate-950">Configuración</h3>
            <p class="mt-2 text-sm text-slate-600">Ajusta la configuración general del sistema.</p>
        </div>
    </div>
</div>
