@model RentingBooking.Models.Property

@{
    ViewData["Title"] = Model?.Id != Guid.Empty ? "Editar propiedad" : "Publicar propiedad";
    var isEditing = Model?.Id != Guid.Empty;
    var previewImage = Model?.Images?.FirstOrDefault()?.Url ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=600&q=80";
}

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-slate-950">@(isEditing ? "Edita tu propiedad" : "Publica tu espacio")</h1>
        <p class="mt-3 text-slate-600">@(isEditing ? "Actualiza la información de tu alojamiento." : "Cuéntanos sobre tu propiedad para empezar a recibir huéspedes.")</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 rounded-[28px] border px-6 py-4 text-sm shadow-sm"
             style="border-color:#f4d7dc; background:#fff1f3; color:#7d141f;">
            <p>@TempData["ErrorMessage"]</p>
        </div>
    }

    <form asp-controller="Property" 
          asp-action="@(isEditing ? "UpdateProperty" : "CreateProperty")" 
          asp-route-id="@(isEditing ? Model.Id : (Guid?)null)"
          method="post" 
          class="space-y-6">
        @Html.AntiForgeryToken()

        <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm sm:p-8">
            <div class="mb-6 flex items-center gap-3">
                <svg class="h-6 w-6 text-[#b41531]" viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
                    <path d="M12 8V12M12 16H12.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <h2 class="text-xl font-bold text-slate-950">Información básica</h2>
            </div>

            <div class="space-y-5">
                <div>
                    <label asp-for="Title" class="block text-sm font-semibold text-slate-950">Título del anuncio</label>
                    <input asp-for="Title" type="text" placeholder="Ej: Acogedora cabaña en el bosque" class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm placeholder-slate-400 text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
                    <span asp-validation-for="Title" class="mt-2 block text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Description" class="block text-sm font-semibold text-slate-950">Descripción</label>
                    <textarea asp-for="Description" placeholder="Describe lo que hace único a tu espacio..." rows="5" class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm placeholder-slate-400 text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc] resize-none"></textarea>
                    <span asp-validation-for="Description" class="mt-2 block text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Location" class="block text-sm font-semibold text-slate-950">Ubicación</label>
                    <input asp-for="Location" type="text" placeholder="Ciudad, Estado, País" class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm placeholder-slate-400 text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
                    <span asp-validation-for="Location" class="mt-2 block text-xs text-red-600"></span>
                </div>
            </div>
        </div>

        <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm sm:p-8">
            <div class="mb-6 flex items-center gap-3">
                <svg class="h-6 w-6 text-[#b41531]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                </svg>
                <h2 class="text-xl font-bold text-slate-950">Precio</h2>
            </div>
            <div>
                <label asp-for="PricePerNight" class="block text-sm font-semibold text-slate-950">Precio por noche</label>
                <input asp-for="PricePerNight" type="number" step="0.01" placeholder="0.00" class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm placeholder-slate-400 text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
                <span asp-validation-for="PricePerNight" class="mt-2 block text-xs text-red-600"></span>
            </div>
        </div>

        <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm sm:p-8">
            <div class="mb-6 flex items-center gap-3">
                <svg class="h-6 w-6 text-[#b41531]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21 16V4H3V16H21ZM21 18H3V20H21V18Z" />
                </svg>
                <h2 class="text-xl font-bold text-slate-950">Características de la propiedad</h2>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label class="block text-sm font-semibold text-slate-950">Habitaciones</label>
                    <input asp-for="Features.Bedrooms" type="number" min="1" value="@(Model.Features?.Bedrooms ?? 1)" class="mt-2 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-950">Baños</label>
                    <input asp-for="Features.Bathrooms" type="number" min="1" value="@(Model.Features?.Bathrooms ?? 1)" class="mt-2 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-950">Camas</label>
                    <input asp-for="Features.Beds" type="number" min="1" value="@(Model.Features?.Beds ?? 1)" class="mt-2 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-950">Máx. huéspedes</label>
                    <input asp-for="Features.MaxGuests" type="number" min="1" value="@(Model.Features?.MaxGuests ?? 2)" class="mt-2 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
                </div>
            </div>
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
                <label class="flex items-center gap-3 rounded-[16px] border border-slate-300 bg-[#fff6f8] px-4 py-3 text-sm text-slate-700 cursor-pointer hover:border-[#b41531] transition">
                    <input asp-for="Features.HasWifi" type="checkbox" class="h-5 w-5 accent-[#b41531]" checked="@(Model.Features?.HasWifi ?? true)" />
                    <span>WiFi</span>
                </label>
                <label class="flex items-center gap-3 rounded-[16px] border border-slate-300 bg-[#fff6f8] px-4 py-3 text-sm text-slate-700 cursor-pointer hover:border-[#b41531] transition">
                    <input asp-for="Features.HasAC" type="checkbox" class="h-5 w-5 accent-[#b41531]" checked="@(Model.Features?.HasAC ?? false)" />
                    <span>Aire Acondicionado</span>
                </label>
                <label class="flex items-center gap-3 rounded-[16px] border border-slate-300 bg-[#fff6f8] px-4 py-3 text-sm text-slate-700 cursor-pointer hover:border-[#b41531] transition">
                    <input asp-for="Features.HasKitchen" type="checkbox" class="h-5 w-5 accent-[#b41531]" checked="@(Model.Features?.HasKitchen ?? false)" />
                    <span>Cocina</span>
                </label>
                <label class="flex items-center gap-3 rounded-[16px] border border-slate-300 bg-[#fff6f8] px-4 py-3 text-sm text-slate-700 cursor-pointer hover:border-[#b41531] transition">
                    <input asp-for="Features.HasParking" type="checkbox" class="h-5 w-5 accent-[#b41531]" checked="@(Model.Features?.HasParking ?? false)" />
                    <span>Estacionamiento</span>
                </label>
                <label class="flex items-center gap-3 rounded-[16px] border border-slate-300 bg-[#fff6f8] px-4 py-3 text-sm text-slate-700 cursor-pointer hover:border-[#b41531] transition">
                    <input asp-for="Features.HasTV" type="checkbox" class="h-5 w-5 accent-[#b41531]" checked="@(Model.Features?.HasTV ?? false)" />
                    <span>TV</span>
                </label>
                <label class="flex items-center gap-3 rounded-[16px] border border-slate-300 bg-[#fff6f8] px-4 py-3 text-sm text-slate-700 cursor-pointer hover:border-[#b41531] transition">
                    <input asp-for="Features.HasPool" type="checkbox" class="h-5 w-5 accent-[#b41531]" checked="@(Model.Features?.HasPool ?? false)" />
                    <span>Piscina</span>
                </label>
            </div>
        </div>

        <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm sm:p-8">
            <div class="mb-6 flex items-center gap-3">
                <svg class="h-6 w-6 text-[#b41531]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM9 17H7V10H9V17ZM13 17H11V7H13V17ZM17 17H15V12H17V17Z" />
                </svg>
                <h2 class="text-xl font-bold text-slate-950">Foto de la propiedad</h2>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-950">URL de la imagen</label>
                <input type="text" name="Images[0].Url" placeholder="https://ejemplo.com/foto.jpg" class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm placeholder-slate-400 text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
            </div>
        </div>

        <div class="rounded-[32px] border border-[#f4d7dc] bg-white overflow-hidden shadow-sm">
            <div class="relative overflow-hidden rounded-t-[32px] bg-slate-200 h-64">
                <img src="@previewImage" alt="Vista previa" class="h-full w-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end p-6">
                    <div class="text-white">
                        <p class="text-sm font-medium">Vista previa del estilo</p>
                        <h3 class="mt-2 text-2xl font-bold">Inspira a tus viajeros</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex gap-4 pt-6">
            <a asp-controller="Owner" asp-action="OwnerLanding" class="flex-1 rounded-full border border-slate-300 px-6 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-[#b41531] hover:text-[#b41531]">
                Cancelar
            </a>
            <button type="submit" class="flex-1 rounded-full bg-[#b41531] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                @(isEditing ? "Guardar cambios" : "Publicar propiedad")
            </button>
        </div>
    </form>
</div>
