@model IEnumerable<RentingBooking.Models.Property>

@{
    ViewData["Title"] = "Explorar propiedades";
    var properties = Model?.ToList() ?? new List<RentingBooking.Models.Property>();
}

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-950">Explorar propiedades</h1>
        <p class="mt-2 text-slate-600">Descubre alojamientos únicos para tu próxima estancia.</p>
    </div>

    @if (!properties.Any())
    {
        <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-8 text-center shadow-sm">
            <svg class="mx-auto h-16 w-16 text-[#f4d7dc]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9L12 2L21 9V20C21 21.1 20.1 22 19 22H5C3.9 22 3 21.1 3 20V9Z" />
                <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            <h3 class="mt-4 text-lg font-semibold text-slate-950">No hay propiedades disponibles</h3>
            <p class="mt-2 text-sm text-slate-600">Vuelve a consultar más tarde.</p>
        </div>
    }
    else
    {
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var property in properties)
            {
                <a asp-controller="Property" asp-action="GetPropertyById" asp-route-id="@property.Id" class="rounded-[32px] border border-[#f4d7dc] bg-white shadow-sm overflow-hidden transition hover:shadow-md group">
                    <div class="relative overflow-hidden rounded-t-[32px] bg-slate-200 h-48">
                        <img src="@(property.Images?.FirstOrDefault()?.Url ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=600&q=80")" alt="@property.Title" class="h-full w-full object-cover group-hover:scale-105 transition duration-300" />
                    </div>
                    <div class="p-5">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="text-lg font-semibold text-slate-950">@property.Title</h3>
                        </div>
                        <div class="mt-2 flex items-center gap-2 text-sm text-slate-600">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                            </svg>
                            @property.Location
                        </div>
                        <div class="mt-4 border-t border-[#f4d7dc] pt-4">
                            <p class="text-sm text-slate-600">Precio por noche</p>
                            <p class="mt-1 text-2xl font-bold text-[#b41531]">@property.PricePerNight.ToString("C")</p>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
