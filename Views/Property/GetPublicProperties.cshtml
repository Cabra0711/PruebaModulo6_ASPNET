@model IEnumerable<RentingBooking.Models.Property>

@{
    ViewData["Title"] = "Explorar propiedades";
    var properties = Model?.ToList() ?? new List<RentingBooking.Models.Property>();
}

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-950">Explorar propiedades</h1>
        <p class="mt-2 text-slate-600">Descubre alojamientos únicos para tu próxima estancia.</p>
    </div>

    @if (!properties.Any())
    {
        <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-8 text-center shadow-sm">
            <svg class="mx-auto h-16 w-16 text-[#f4d7dc]" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9L12 2L21 9V20C21 21.1 20.1 22 19 22H5C3.9 22 3 21.1 3 20V9Z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <h3 class="mt-4 text-lg font-semibold text-slate-950">No hay propiedades disponibles</h3>
            <p class="mt-2 text-sm text-slate-600">Vuelve a consultar más tarde.</p>
        </div>
    }
    else
    {
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var property in properties)
            {
                <div
                    class="rounded-[32px] border border-[#f4d7dc] bg-white shadow-sm overflow-hidden transition hover:shadow-md group relative">
                    <a asp-controller="Property" asp-action="GetPropertyById" asp-route-id="@property.Id" class="block">
                        <div class="relative overflow-hidden rounded-t-[32px] bg-slate-200 h-48">
                            <img
                                src="@(property.Images?.FirstOrDefault()?.Url ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=600&q=80")"
                                alt="@property.Title"
                                class="h-full w-full object-cover group-hover:scale-105 transition duration-300"/>
                        </div>
                        <div class="p-5">
                            <h3 class="text-lg font-semibold text-slate-950">@property.Title</h3>
                            <div class="mt-2 flex items-center gap-2 text-sm text-slate-600">
                                @property.Location
                            </div>
                            @if (property.Features != null)
                            {
                                <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-600">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-[#fff1f3] px-2.5 py-1">@property.Features.MaxGuests huéspedes</span>
                                    <span class="inline-flex items-center gap-1 rounded-full bg-[#fff1f3] px-2.5 py-1">@property.Features.Bedrooms dorm.</span>
                                    <span class="inline-flex items-center gap-1 rounded-full bg-[#fff1f3] px-2.5 py-1">@property.Features.Beds camas</span>
                                    <span class="inline-flex items-center gap-1 rounded-full bg-[#fff1f3] px-2.5 py-1">@property.Features.Bathrooms baños</span>
                                </div>
                            }
                            <div class="mt-4 border-t border-[#f4d7dc] pt-4">
                                <p class="text-sm text-slate-600">Precio por noche</p>
                                <p class="mt-1 text-2xl font-bold text-[#b41531]">@property.PricePerNight.ToString("C")</p>
                            </div>
                        </div>
                    </a>

                    @if (User.IsInRole("User"))
                    {
                        <form asp-controller="Wishlist" asp-action="Add" asp-route-propertyId="@property.Id"
                              method="post" class="absolute top-4 right-4">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#b41531] shadow-md transition hover:bg-[#fde3e8]">
                                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">
                                    <path
                                        d="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z"/>
                                </svg>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>
