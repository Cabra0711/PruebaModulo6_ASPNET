@model RentingBooking.Models.Property

@{
    ViewData["Title"] = "Editar propiedad";
    var previewImage = Model?.Images?.FirstOrDefault()?.Url ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=600&q=80";
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-[#fff4f5] text-slate-900">
    <!-- Header -->
    <header class="border-b border-[#f4d7dc] bg-white/90 py-4 shadow-sm sticky top-0 z-50">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 text-[#b41531] font-semibold">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-[#fde3e8] text-xl">♥</span>
                <span class="text-lg hidden sm:inline">RentingBooking</span>
            </a>
            <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#fde3e8] text-[#b41531] transition hover:bg-[#f4d7dc] sm:hidden">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12C13.1 12 14 11.1 14 10C14 8.9 13.1 8 12 8C10.9 8 10 8.9 10 10C10 11.1 10.9 12 12 12ZM12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                </svg>
            </button>
        </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8 pb-32 sm:pb-8">
        <!-- Page Header with Back Button -->
        <div class="mb-8 flex items-start gap-4">
            <a asp-controller="Owner" asp-action="OwnerLanding" class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-600 transition hover:text-[#b41531]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
            </a>
            <div>
                <h1 class="text-3xl font-bold text-slate-950">Editar propiedad</h1>
                <p class="mt-2 text-slate-600">Mantén la información de tu alojamiento actualizada para atraer a más huéspedes.</p>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 rounded-[28px] border px-6 py-4 text-sm shadow-sm"
                 style="border-color:#f4d7dc; background:#fff1f3; color:#7d141f;">
                <p>@TempData["ErrorMessage"]</p>
            </div>
        }

        <form asp-controller="Property" 
              asp-action="UpdateProperty" 
              asp-route-id="@Model.Id"
              method="post" 
              class="space-y-6">
            @Html.AntiForgeryToken()

            <!-- Información General Section -->
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm sm:p-8">
                <div class="mb-6 flex items-center gap-3">
                    <svg class="h-6 w-6 text-[#b41531]" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
                        <path d="M12 8V12M12 16H12.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <h2 class="text-xl font-bold text-slate-950">Información general</h2>
                </div>

                <div class="space-y-5">
                    <!-- Título -->
                    <div>
                        <label asp-for="Title" class="block text-sm font-semibold text-slate-950">Título del anuncio</label>
                        <input asp-for="Title" 
                               type="text" 
                               placeholder="Cabaña de Lujo en Los Andes" 
                               class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm placeholder-slate-400 text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
                        <p class="mt-2 text-xs text-slate-500">Sugiere una ubicación o qué tienen sensaciones.</p>
                        @if (ViewData.ModelState["Title"]?.Errors?.Any() == true)
                        {
                            <p class="mt-1 text-xs text-red-600">@ViewData.ModelState["Title"]?.Errors?.FirstOrDefault()?.ErrorMessage</p>
                        }
                    </div>

                    <!-- Descripción -->
                    <div>
                        <label asp-for="Description" class="block text-sm font-semibold text-slate-950">Descripción</label>
                        <textarea asp-for="Description" 
                                  placeholder="Una experiencia única frente al lago. Esta propiedad cuenta con acabados premium en madera de pino y una chimenea central que es el corazón del hogar" 
                                  rows="5"
                                  class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm placeholder-slate-400 text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc] resize-none"></textarea>
                        @if (ViewData.ModelState["Description"]?.Errors?.Any() == true)
                        {
                            <p class="mt-2 text-xs text-red-600">@ViewData.ModelState["Description"]?.Errors?.FirstOrDefault()?.ErrorMessage</p>
                        }
                    </div>

                    <!-- Ubicación -->
                    <div>
                        <label asp-for="Location" class="block text-sm font-semibold text-slate-950">Ubicación</label>
                        <div class="mt-3 flex items-center gap-3 rounded-[16px] border border-slate-300 bg-white px-4 py-3 transition focus-within:border-[#b41531] focus-within:ring-2 focus-within:ring-[#f4d7dc]">
                            <svg class="h-5 w-5 text-slate-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                            </svg>
                            <input asp-for="Location" 
                                   type="text" 
                                   placeholder="Zermatt, Suiza" 
                                   class="flex-1 bg-white text-sm placeholder-slate-400 text-slate-900 outline-none" />
                        </div>
                        @if (ViewData.ModelState["Location"]?.Errors?.Any() == true)
                        {
                            <p class="mt-2 text-xs text-red-600">@ViewData.ModelState["Location"]?.Errors?.FirstOrDefault()?.ErrorMessage</p>
                        }
                    </div>

                    <!-- Categoría -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-950">Categoría</label>
                        <select class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]">
                            <option>Cabaña</option>
                            <option>Casa</option>
                            <option>Apartamento</option>
                            <option>Villa</option>
                            <option>Loft</option>
                            <option>Resort</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Galería y Servicios Section -->
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm sm:p-8">
                <div class="mb-6 flex items-center gap-3">
                    <svg class="h-6 w-6 text-[#b41531]" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM9 17H7V10H9V17ZM13 17H11V7H13V17ZM17 17H15V12H17V17Z" />
                    </svg>
                    <h2 class="text-xl font-bold text-slate-950">Galería y Servicios</h2>
                </div>

                <!-- Fotos Principales -->
                <div class="mb-8">
                    <p class="text-sm font-semibold text-slate-950">Fotos principales</p>
                    <div class="mt-4 grid grid-cols-2 gap-4">
                        <div class="relative overflow-hidden rounded-[16px] bg-slate-200 h-32">
                            <img src="@previewImage" alt="Foto 1" class="h-full w-full object-cover" />
                        </div>
                        <div class="relative overflow-hidden rounded-[16px] bg-slate-200 h-32">
                            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=400&q=80" alt="Foto 2" class="h-full w-full object-cover" />
                        </div>
                        <div class="col-span-2 flex items-center justify-center rounded-[16px] border-2 border-dashed border-slate-300 bg-slate-50 h-32 cursor-pointer transition hover:border-[#b41531] hover:bg-[#fde3e8]">
                            <div class="text-center">
                                <svg class="mx-auto h-8 w-8 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                                    <circle cx="12" cy="13" r="4" />
                                </svg>
                                <p class="mt-2 text-xs font-semibold text-slate-600">Subir</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Servicios Destacados -->
                <div>
                    <p class="text-sm font-semibold text-slate-950">Servicios destacados</p>
                    <div class="mt-4 flex flex-wrap gap-3">
                        <button type="button" class="inline-flex items-center gap-2 rounded-full border border-[#b41531] bg-white px-4 py-2 text-xs font-semibold text-[#b41531] transition hover:bg-[#fde3e8]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                            </svg>
                            WiFi
                        </button>
                        <button type="button" class="inline-flex items-center gap-2 rounded-full border border-[#b41531] bg-white px-4 py-2 text-xs font-semibold text-[#b41531] transition hover:bg-[#fde3e8]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM9 17H7V10H9V17ZM13 17H11V7H13V17ZM17 17H15V12H17V17Z" />
                            </svg>
                            A/C acondicionado
                        </button>
                        <button type="button" class="inline-flex items-center gap-2 rounded-full border border-[#b41531] bg-white px-4 py-2 text-xs font-semibold text-[#b41531] transition hover:bg-[#fde3e8]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                            </svg>
                            Piscina
                        </button>
                        <button type="button" class="inline-flex items-center gap-2 rounded-full border border-[#b41531] bg-white px-4 py-2 text-xs font-semibold text-[#b41531] transition hover:bg-[#fde3e8]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                            </svg>
                            Parqueadero
                        </button>
                    </div>
                </div>
            </div>

            <!-- Precios y Reserva Section -->
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm sm:p-8">
                <div class="mb-6 flex items-center gap-3">
                    <svg class="h-6 w-6 text-[#b41531]" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                    </svg>
                    <h2 class="text-xl font-bold text-slate-950">Precios y reserva</h2>
                </div>

                <div class="space-y-5">
                    <!-- Precio por noche -->
                    <div>
                        <label asp-for="PricePerNight" class="block text-sm font-semibold text-slate-950">Precio por noche (USD)</label>
                        <div class="mt-3 flex items-center gap-3 rounded-[16px] border border-slate-300 bg-white px-4 py-3 transition focus-within:border-[#b41531] focus-within:ring-2 focus-within:ring-[#f4d7dc]">
                            <span class="text-sm font-semibold text-slate-600">$</span>
                            <input asp-for="PricePerNight" 
                                   type="number" 
                                   step="0.01"
                                   placeholder="250" 
                                   class="flex-1 bg-white text-sm placeholder-slate-400 text-slate-900 outline-none" />
                        </div>
                        @if (ViewData.ModelState["PricePerNight"]?.Errors?.Any() == true)
                        {
                            <p class="mt-2 text-xs text-red-600">@ViewData.ModelState["PricePerNight"]?.Errors?.FirstOrDefault()?.ErrorMessage</p>
                        }
                    </div>

                    <!-- Estancia mínima -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-950">Estancia mínima (Noches)</label>
                        <input type="number" 
                               min="1"
                               placeholder="2" 
                               class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm placeholder-slate-400 text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc]" />
                    </div>

                    <!-- Info Alert -->
                    <div class="rounded-[16px] border border-[#fde3e8] bg-[#fff1f3] p-4">
                        <div class="flex gap-3">
                            <svg class="h-5 w-5 text-[#b41531] flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM13 17H11V15H13V17ZM13 13H11V7H13V13Z" />
                            </svg>
                            <div>
                                <p class="text-xs font-semibold text-[#7d141f]">El precio promedio en esta zona para propiedades similares es de $210.</p>
                                <p class="mt-1 text-xs text-[#7d141f]">Ajustar tu precio podría aumentar tus reservas un 15%.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex flex-col gap-3 pt-6">
                <button type="submit" class="w-full rounded-full bg-[#b41531] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                    Actualizar
                </button>
                <a asp-controller="Owner" asp-action="OwnerLanding" class="w-full rounded-full border border-slate-300 px-6 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-[#b41531] hover:text-[#b41531]">
                    Cancelar cambios
                </a>
            </div>
        </form>
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#f4d7dc] bg-[#fff4f5] py-8 px-4 text-center text-sm text-slate-600 sm:px-6 lg:px-8 mt-8 mb-20 md:mb-0">
        <div class="mx-auto max-w-7xl">
            <p class="font-semibold text-[#b41531]">RentingBooking</p>
            <p class="mt-2">© 2024 RentingBooking Inc.</p>
            <div class="mt-4 flex flex-wrap justify-center gap-4">
                <a href="#" class="transition hover:text-[#b41531]">Privacy</a>
                <a href="#" class="transition hover:text-[#b41531]">Terms</a>
                <a href="#" class="transition hover:text-[#b41531]">Sitemap</a>
            </div>
        </div>
    </footer>

    <!-- Bottom Navigation (Mobile) -->
    <nav class="fixed bottom-0 left-0 right-0 border-t border-[#f4d7dc] bg-white shadow-2xl md:hidden">
        <div class="flex items-center justify-around px-4 py-3">
            <a asp-controller="Property" asp-action="GetPublicProperties" class="flex flex-col items-center gap-1 text-slate-600 transition hover:text-[#b41531]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M15.5 1H4C2.34 1 1 2.34 1 4V20C1 21.66 2.34 23 4 23H20C21.66 23 23 21.66 23 20V8.5L15.5 1ZM12 19C10.34 19 9 17.66 9 16C9 14.34 10.34 13 12 13C13.66 13 15 14.34 15 16C15 17.66 13.66 19 12 19ZM18 9H4V4H18V9Z" />
                </svg>
                <span class="text-xs">Explorar</span>
            </a>
            <a asp-controller="Wishlist" asp-action="Index" class="flex flex-col items-center gap-1 text-slate-600 transition hover:text-[#b41531]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" />
                </svg>
                <span class="text-xs">Wishlist</span>
            </a>
            <a asp-controller="User" asp-action="MyBookings" class="flex flex-col items-center gap-1 text-[#b41531] transition hover:text-[#991a30]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM9 17H7V10H9V17ZM13 17H11V7H13V17ZM17 17H15V12H17V17Z" />
                </svg>
                <span class="text-xs">Bookings</span>
            </a>
            <a asp-controller="User" asp-action="Profile" class="flex flex-col items-center gap-1 text-slate-600 transition hover:text-[#b41531]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12C13.1 12 14 11.1 14 10C14 8.9 13.1 8 12 8C10.9 8 10 8.9 10 10C10 11.1 10.9 12 12 12ZM12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                </svg>
                <span class="text-xs">Perfil</span>
            </a>
        </div>
    </nav>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
