@model RentingBooking.Models.Property

@{
    ViewData["Title"] = Model.Title;
    var features = Model.Features;
    var reviews = Model.Reviews?.OrderByDescending(r => r.CreatedAt).Take(3).ToList() ?? new();
    var avgRating = Model.Reviews != null && Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0;
    var reviewCount = Model.Reviews?.Count ?? 0;
}

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    @if (TempData["ErrorMessage"] != null || TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 rounded-[28px] border px-6 py-4 text-sm shadow-sm sm:px-8 "
             style="border-color:#f4d7dc; background:#fff1f3; color:#7d141f;">
            @if (TempData["ErrorMessage"] != null)
            {
                <p>@TempData["ErrorMessage"]</p>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <p>@TempData["SuccessMessage"]</p>
            }
        </div>
    }

    <div class="grid gap-8 lg:grid-cols-[1.7fr_0.9fr]">
        <section class="space-y-6">
            <div class="rounded-[40px] bg-white shadow-[0_30px_80px_rgba(15,23,42,0.08)]">
                <div class="relative overflow-hidden rounded-[40px]">
                    <img src="@(Model.Images?.FirstOrDefault()?.Url ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1600&q=80")" alt="@Model.Title" class="h-[420px] w-full object-cover" />
                    <div class="absolute inset-x-0 top-0 flex items-center justify-between p-5">
                        <div class="inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-[#b41531] shadow-sm">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3C9.23858 3 7 5.23858 7 8C7 11.55 12 18 12 18C12 18 17 11.55 17 8C17 5.23858 14.7614 3 12 3Z" />
                                <circle cx="12" cy="8" r="2" />
                            </svg>
                            @Model.Location
                        </div>
                        @if (User.IsInRole("User"))
                        {
                            <form asp-controller="Wishlist" asp-action="Add" asp-route-propertyId="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#fff1f3] text-[#b41531] transition hover:bg-[#f8d8de] shadow-sm">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" />
                                    </svg>
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <div class="space-y-6 p-6 sm:p-8">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <h1 class="mt-3 text-4xl font-semibold text-slate-950">@Model.Title</h1>
                            <p class="mt-4 text-sm text-slate-600">@Model.Location</p>
                        </div>
                    </div>

                    @if (features != null)
                    {
                        <div class="flex flex-wrap gap-3 text-sm text-slate-600">
                            <span class="inline-flex items-center gap-2 rounded-full bg-[#fff1f3] px-3 py-2">@features.MaxGuests huéspedes</span>
                            <span class="inline-flex items-center gap-2 rounded-full bg-[#fff1f3] px-3 py-2">@features.Bedrooms dormitorios</span>
                            <span class="inline-flex items-center gap-2 rounded-full bg-[#fff1f3] px-3 py-2">@features.Beds camas</span>
                            <span class="inline-flex items-center gap-2 rounded-full bg-[#fff1f3] px-3 py-2">@features.Bathrooms baños</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-wrap gap-3 text-sm text-slate-500">
                            <span class="inline-flex items-center gap-2 rounded-full bg-[#fff1f3] px-3 py-2">Características no disponibles</span>
                        </div>
                    }

                    <div class="flex items-center gap-3">
                        <div class="h-12 w-12 overflow-hidden rounded-full border border-[#f4d7dc] bg-white">
                            <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=240&q=80" alt="Anfitrión" class="h-full w-full object-cover" />
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-950">@(Model.Host?.Username ?? "Anfitrión")</p>
                            <p class="text-xs text-slate-500">Anfitrión</p>
                        </div>
                        @if (avgRating > 0)
                        {
                            <div class="ml-auto flex items-center gap-1 text-sm">
                                <span class="text-yellow-500">★</span>
                                <span class="font-semibold text-slate-950">@avgRating.ToString("F1")</span>
                                <span class="text-slate-500">(@reviewCount @(reviewCount == 1 ? "reseña" : "reseñas"))</span>
                            </div>
                        }
                    </div>

                    @if (features != null)
                    {
                        <div class="rounded-[28px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#b41531]">Lo que este lugar ofrece</p>
                            <div class="mt-5 grid gap-3 sm:grid-cols-2">
                                @if (features.HasWifi)
                                {
                                    <div class="flex items-center gap-3 rounded-3xl bg-[#fff6f8] p-4">
                                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-[#b41531]">
                                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12H19" /><path d="M12 5L12 19" /></svg>
                                        </span>
                                        <span>WiFi de alta velocidad</span>
                                    </div>
                                }
                                @if (features.HasAC)
                                {
                                    <div class="flex items-center gap-3 rounded-3xl bg-[#fff6f8] p-4">
                                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-[#b41531]">
                                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7H20V17C20 18.1 19.1 19 18 19H6C4.9 19 4 18.1 4 17V7Z" /><path d="M8 7V5C8 3.9 8.9 3 10 3H14C15.1 3 16 3.9 16 5V7" /></svg>
                                        </span>
                                        <span>Aire acondicionado</span>
                                    </div>
                                }
                                @if (features.HasKitchen)
                                {
                                    <div class="flex items-center gap-3 rounded-3xl bg-[#fff6f8] p-4">
                                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-[#b41531]">
                                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3L2 9L12 15L22 9L12 3Z" /><path d="M2 15L12 21L22 15" /></svg>
                                        </span>
                                        <span>Cocina equipada</span>
                                    </div>
                                }
                                @if (features.HasParking)
                                {
                                    <div class="flex items-center gap-3 rounded-3xl bg-[#fff6f8] p-4">
                                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-[#b41531]">
                                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12H19" /><path d="M5 16H19" /><path d="M7 8H17" /></svg>
                                        </span>
                                        <span>Estacionamiento gratuito</span>
                                    </div>
                                }
                                @if (features.HasTV)
                                {
                                    <div class="flex items-center gap-3 rounded-3xl bg-[#fff6f8] p-4">
                                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-[#b41531]">
                                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L2 2L2 18L22 18L22 2Z" /><path d="M8 22L16 22" /><path d="M12 18L12 22" /></svg>
                                        </span>
                                        <span>TV</span>
                                    </div>
                                }
                                @if (features.HasPool)
                                {
                                    <div class="flex items-center gap-3 rounded-3xl bg-[#fff6f8] p-4">
                                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white text-[#b41531]">
                                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20C6 20 6 16 10 16C14 16 14 20 18 20C22 20 22 16 22 16" /><path d="M2 12C6 12 6 8 10 8C14 8 14 12 18 12C22 12 22 8 22 8" /></svg>
                                        </span>
                                        <span>Piscina</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-[28px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#b41531]">Lo que este lugar ofrece</p>
                            <p class="mt-5 text-sm text-slate-500">Esta propiedad no tiene características registradas.</p>
                        </div>
                    }

                    <div class="space-y-4">
                        <div>
                            <h2 class="text-xl font-semibold text-slate-950">Sobre este espacio</h2>
                            <p class="mt-4 text-sm leading-7 text-slate-600">@Model.Description</p>
                        </div>
                    </div>

                    @if (reviews.Any())
                    {
                        <div class="rounded-[28px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-bold text-slate-950">Reseñas destacadas</h3>
                                <span class="text-sm text-slate-500">@reviewCount en total</span>
                            </div>
                            <div class="space-y-4">
                                @foreach (var review in reviews)
                                {
                                    <div class="border-t border-[#f4d7dc] pt-4">
                                        <div class="flex items-start gap-3">
                                            <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#b41531] text-white text-sm font-bold">
                                                @(review.User?.Username?.FirstOrDefault().ToString()?.ToUpper() ?? "U")
                                            </div>
                                            <div class="flex-1">
                                                <div class="flex items-center gap-2">
                                                    <p class="text-sm font-semibold text-slate-950">@(review.User?.Username ?? "Usuario")</p>
                                                    <span class="text-xs text-slate-400">@review.CreatedAt.ToString("dd MMM yyyy")</span>
                                                </div>
                                                <div class="mt-1 flex items-center gap-0.5">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <span class="text-sm @(i <= review.Rating ? "text-yellow-500" : "text-slate-300")">★</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(review.Comment))
                                                {
                                                    <p class="mt-2 text-sm text-slate-600">@review.Comment</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <aside class="space-y-6">
            <div class="rounded-[40px] border border-[#f4d7dc] bg-white p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] sm:p-8">
                <div class="flex items-center justify-between gap-4">
                    <div>
                        <p class="text-sm uppercase tracking-[0.3em] text-[#b41531]">@Model.PricePerNight.ToString("C") / noche</p>
                        <div class="mt-3 flex items-center gap-2 text-sm text-slate-600">
                            @if (avgRating > 0)
                            {
                                <span class="font-semibold text-slate-950">@avgRating.ToString("F1")</span>
                                <span>★</span>
                                <span>•</span>
                            }
                            <span>@reviewCount @(reviewCount == 1 ? "reseña" : "reseñas")</span>
                        </div>
                    </div>
                </div>

                <form asp-controller="Booking" asp-action="CreateBooking" asp-route-propertyId="@Model.Id" method="get" class="mt-8 space-y-5">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <label class="space-y-2 text-sm text-slate-700">
                            <span>Llegada</span>
                            <input name="checkIn" type="date" required min="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full rounded-[20px] border border-[#e9d6dc] bg-[#fff6f8] px-4 py-3 text-sm text-slate-900 outline-none focus:border-[#b41531] focus:ring-2 focus:ring-[#f8d8de]" />
                        </label>
                        <label class="space-y-2 text-sm text-slate-700">
                            <span>Salida</span>
                            <input name="checkOut" type="date" required min="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full rounded-[20px] border border-[#e9d6dc] bg-[#fff6f8] px-4 py-3 text-sm text-slate-900 outline-none focus:border-[#b41531] focus:ring-2 focus:ring-[#f8d8de]" />
                        </label>
                    </div>
                    <button type="submit" class="w-full rounded-[22px] bg-[#b41531] px-6 py-4 text-sm font-semibold text-white shadow-[0_16px_30px_rgba(180,21,49,0.25)] transition hover:bg-[#9c1227]">Reservar</button>
                </form>
                <p class="mt-4 text-center text-xs text-slate-500">No se te cobrará nada todavía. Protección contra fraudes incluida en tu reserva.</p>
            </div>

            <div class="rounded-[40px] border border-[#f4d7dc] bg-white p-6 shadow-[0_20px_60px_rgba(15,23,42,0.08)] sm:p-8">
                <h3 class="text-sm font-semibold uppercase tracking-[0.3em] text-[#b41531]">Anfitrión</h3>
                <div class="mt-4 flex items-center gap-3">
                    <div class="h-14 w-14 overflow-hidden rounded-full border border-[#f4d7dc] bg-white">
                        <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=240&q=80" alt="Anfitrión" class="h-full w-full object-cover" />
                    </div>
                    <div>
                        <p class="text-base font-semibold text-slate-950">@(Model.Host?.Username ?? "Anfitrión")</p>
                        <p class="text-sm text-slate-500">Miembro desde @(Model.Host?.CreatedAt.ToString("yyyy") ?? "2024")</p>
                        @if (reviewCount > 0)
                        {
                            <div class="flex items-center gap-1 text-sm mt-1">
                                <span class="text-yellow-500">★</span>
                                <span class="text-slate-700">@avgRating.ToString("F1") · @reviewCount reseñas</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>
