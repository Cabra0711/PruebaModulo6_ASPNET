@model RentingBooking.Models.Booking

@{
    ViewData["Title"] = "Reserva Confirmada";
    var nights = (Model.CheckOutDate.ToDateTime(TimeOnly.MinValue) - Model.CheckInDate.ToDateTime(TimeOnly.MinValue)).Days;
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-gray-100 flex flex-col">
    <!-- Header -->
    <div class="bg-[#b41531] text-white py-6 px-4 text-center shadow-lg">
        <div class="flex items-center justify-center gap-2">
            <span class="text-2xl">🏠</span>
            <h1 class="text-2xl font-bold">RentingBooking</h1>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 flex items-center justify-center px-4 py-12">
        <div class="bg-white rounded-lg shadow-lg max-w-md w-full p-8 text-center">
            <!-- Greeting -->
            <p class="text-sm text-slate-600 mb-4">Hola, <span class="font-bold">@Model?.Guest?.Username ?? "Usuario"</span></p>
            
            <!-- Main Message -->
            <p class="text-slate-700 mb-6 text-sm leading-relaxed">
                Tu reserva ha sido confirmada exitosamente. Aquí tienes los detalles de tu estancia:
            </p>

            <!-- Booking Details -->
            <div class="bg-slate-50 rounded-lg p-4 mb-6 text-left text-sm space-y-3">
                <div class="border-b border-gray-200 pb-3">
                    <p class="font-semibold">Propiedad</p>
                    <p class="text-slate-600">@Model?.Property?.Title</p>
                </div>
                <div class="border-b border-gray-200 pb-3">
                    <p class="font-semibold">Ubicación</p>
                    <p class="text-slate-600">@Model?.Property?.Location</p>
                </div>
                <div class="border-b border-gray-200 pb-3">
                    <p class="font-semibold">Check-in</p>
                    <p class="text-slate-600">@Model?.CheckInDate.ToString("dd MMM yyyy") a las 14:00 hs</p>
                </div>
                <div class="border-b border-gray-200 pb-3">
                    <p class="font-semibold">Check-out</p>
                    <p class="text-slate-600">@Model?.CheckOutDate.ToString("dd MMM yyyy") a las 12:00 hs</p>
                </div>
                <div class="border-b border-gray-200 pb-3">
                    <p class="font-semibold">Noches</p>
                    <p class="text-slate-600">@nights</p>
                </div>
                <div>
                    <p class="font-semibold">Total pagado</p>
                    <p class="text-slate-600">${@Model?.TotalPrice.ToString("N2")}</p>
                </div>
            </div>

            <!-- CTA Button -->
            <a asp-controller="User" asp-action="MyBookings" class="inline-block bg-[#b41531] text-white px-6 py-2 rounded-md font-semibold hover:bg-[#991a30] transition mb-4">
                Ver mi reserva
            </a>
        </div>
    </div>

    <!-- Footer -->
    <div class="bg-white border-t border-gray-200 text-center py-4 px-4">
        <p class="text-xs text-gray-500">© 2026 RentingBooking · Todos los derechos reservados</p>
    </div>
</div>