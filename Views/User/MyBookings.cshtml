@model IEnumerable<RentingBooking.Models.Booking>

@{
    ViewData["Title"] = "Mis reservas";
    var allBookings = Model.ToList();
    var bookingCount = allBookings.Count();
}

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        @if (TempData["ErrorMessage"] != null || TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 rounded-[28px] border px-6 py-4 text-sm shadow-sm"
                 style="border-color:#f4d7dc; background:#fff1f3; color:#7d141f;">
                @if (TempData["ErrorMessage"] != null)
                {
                    <p>@TempData["ErrorMessage"]</p>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <p>@TempData["SuccessMessage"]</p>
                }
            </div>
        }

        <div class="mb-8">
            <h1 class="text-3xl font-semibold text-slate-950">Mis reservas</h1>
            <p class="mt-2 text-sm text-slate-600">Tienes @bookingCount reservas programadas.</p>
        </div>

        <div class="mb-8 flex flex-wrap gap-2 rounded-[24px] border border-[#f4d7dc] bg-white p-2 shadow-sm">
            <button type="button" class="filter-btn rounded-full bg-[#b41531] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#991a30]" data-filter="all">
                All
            </button>
            <button type="button" class="filter-btn rounded-full bg-white px-5 py-2 text-sm font-semibold text-slate-700 transition hover:bg-[#fff1f3]" data-filter="PendingPayment">
                Pending
            </button>
            <button type="button" class="filter-btn rounded-full bg-white px-5 py-2 text-sm font-semibold text-slate-700 transition hover:bg-[#fff1f3]" data-filter="Paid">
                Paid
            </button>
            <button type="button" class="filter-btn rounded-full bg-white px-5 py-2 text-sm font-semibold text-slate-700 transition hover:bg-[#fff1f3]" data-filter="Completed">
                Completed
            </button>
        </div>

        @if (!allBookings.Any())
        {
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-8 text-center shadow-sm">
                <p class="text-lg font-semibold text-slate-950">No tienes reservas registradas.</p>
                <p class="mt-2 text-sm text-slate-600">Empieza a explorar propiedades y crea tu primera reserva.</p>
                <a asp-controller="Property" asp-action="GetPublicProperties" class="mt-6 inline-flex rounded-full bg-[#b41531] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                    Explorar propiedades
                </a>
            </div>
        }
        else
        {
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var booking in allBookings)
                {
                    var statusClass = booking.Status.ToString() switch
                    {
                        "PendingPayment" => "bg-[#fde2e7] text-[#b41531]",
                        "Paid" => "bg-[#def7e3] text-[#1f7a43]",
                        "Completed" => "bg-[#e0e7ff] text-[#4f46e5]",
                        _ => "bg-[#f3f4f6] text-slate-700"
                    };
                    
                    var statusLabel = booking.Status.ToString() switch
                    {
                        "PendingPayment" => "Pending",
                        "Paid" => "Paid",
                        "Completed" => "Completed",
                        _ => booking.Status.ToString()
                    };

                    var isCompleted = booking.Status.ToString() == "Completed";
                    var canReview = isCompleted && booking.CheckOutDate < DateOnly.FromDateTime(DateTime.Today);

                    <div class="booking-card rounded-[32px] border border-[#f4d7dc] bg-white shadow-sm overflow-hidden transition hover:shadow-md" data-status="@booking.Status">
                        <div class="relative overflow-hidden rounded-t-[32px] bg-slate-200 h-48">
                            <img src="@(booking.Property.Images?.FirstOrDefault()?.Url ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=600&q=80")" alt="@booking.Property.Title" class="h-full w-full object-cover" />
                            <span class="absolute top-4 right-4 inline-flex items-center gap-1 rounded-full bg-white px-3 py-1.5 text-xs font-semibold @statusClass">
                                @if (statusLabel == "Paid")
                                {
                                    <span class="h-2 w-2 rounded-full bg-[#1f7a43]"></span>
                                }
                                @statusLabel
                            </span>
                        </div>

                        <div class="p-5 sm:p-6">
                            <h3 class="text-lg font-semibold text-slate-950">@booking.Property.Title</h3>

                            <div class="mt-4 space-y-3 text-sm text-slate-600">
                                <div class="flex items-center gap-3">
                                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-[#fff1f3] text-[#b41531]">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3Z" />
                                            <path d="M16 2V6" />
                                            <path d="M8 2V6" />
                                            <path d="M3 10H21" />
                                        </svg>
                                    </span>
                                    <div>
                                        <p class="text-xs uppercase tracking-[0.3em] text-slate-500">Check-in</p>
                                        <p class="mt-1 font-semibold text-slate-900">@booking.CheckInDate.ToString("dd MMM, yyyy")</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-[#fff1f3] text-[#b41531]">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3Z" />
                                            <path d="M16 2V6" />
                                            <path d="M8 2V6" />
                                            <path d="M3 10H21" />
                                        </svg>
                                    </span>
                                    <div>
                                        <p class="text-xs uppercase tracking-[0.3em] text-slate-500">Check-out</p>
                                        <p class="mt-1 font-semibold text-slate-900">@booking.CheckOutDate.ToString("dd MMM, yyyy")</p>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-5 border-t border-[#f4d7dc] pt-4">
                                <p class="text-sm text-slate-600">Total</p>
                                <p class="mt-2 text-2xl font-semibold text-[#b41531]">@booking.TotalPrice.ToString("C")</p>
                            </div>

                            <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:gap-3">
                                <a asp-controller="Property" asp-action="GetPropertyById" asp-route-id="@booking.Property.Id" class="flex-1 rounded-full border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-[#b41531] hover:text-[#b41531]">
                                    Ver propiedad
                                </a>
                                @if (booking.Status.ToString() == "PendingPayment")
                                {
                                    <form asp-controller="Booking" asp-action="CancelBooking" asp-route-bookingId="@booking.Id" method="post" class="flex-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-full rounded-full border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-[#b41531] hover:text-[#b41531]">
                                            Cancelar
                                        </button>
                                    </form>
                                    <form asp-controller="Booking" asp-action="PayBooking" asp-route-bookingId="@booking.Id" method="post" class="flex-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-full rounded-full bg-[#b41531] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                                            Pagar
                                        </button>
                                    </form>
                                }
                                else if (booking.Status.ToString() == "Paid")
                                {
                                    <form asp-controller="Booking" asp-action="CancelBooking" asp-route-bookingId="@booking.Id" method="post" class="flex-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-full rounded-full border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-[#b41531] hover:text-[#b41531]">
                                            Cancelar
                                        </button>
                                    </form>
                                }
                                else if (isCompleted)
                                {
                                    <a asp-controller="Property" asp-action="GetPublicProperties" class="flex-1 rounded-full border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-[#b41531] hover:text-[#b41531]">
                                        Volver a reservar
                                    </a>
                                    @if (canReview)
                                    {
                                        <button type="button" onclick="openReviewModal('@booking.Id', '@booking.Property.Title')" class="flex-1 rounded-full bg-[#b41531] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                                            Reseñar
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
</div>

<!-- Review Modal -->
<div id="reviewModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="mx-4 w-full max-w-md rounded-[32px] bg-white p-6 shadow-2xl sm:p-8">
        <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-slate-950">Deja tu reseña</h3>
            <button type="button" onclick="closeReviewModal()" class="inline-flex h-8 w-8 items-center justify-center rounded-full text-slate-400 hover:text-slate-600">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <p id="reviewPropertyName" class="mt-2 text-sm text-slate-600"></p>

        <form id="reviewForm" method="post" class="mt-6 space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookingId" id="reviewBookingId" value="" />

            <div>
                <label class="block text-sm font-semibold text-slate-950 mb-3">Puntuación</label>
                <div class="flex flex-row-reverse justify-center gap-2" id="starRating">
                    <input type="radio" name="rating" value="5" id="star5" class="peer hidden" />
                    <label for="star5" class="star-label cursor-pointer text-3xl text-slate-300 transition hover:text-yellow-400 peer-checked:text-yellow-400" data-value="5">★</label>
                    <input type="radio" name="rating" value="4" id="star4" class="peer hidden" />
                    <label for="star4" class="star-label cursor-pointer text-3xl text-slate-300 transition hover:text-yellow-400 peer-checked:text-yellow-400" data-value="4">★</label>
                    <input type="radio" name="rating" value="3" id="star3" class="peer hidden" />
                    <label for="star3" class="star-label cursor-pointer text-3xl text-slate-300 transition hover:text-yellow-400 peer-checked:text-yellow-400" data-value="3">★</label>
                    <input type="radio" name="rating" value="2" id="star2" class="peer hidden" />
                    <label for="star2" class="star-label cursor-pointer text-3xl text-slate-300 transition hover:text-yellow-400 peer-checked:text-yellow-400" data-value="2">★</label>
                    <input type="radio" name="rating" value="1" id="star1" class="peer hidden" />
                    <label for="star1" class="star-label cursor-pointer text-3xl text-slate-300 transition hover:text-yellow-400 peer-checked:text-yellow-400" data-value="1">★</label>
                </div>
                <p id="starError" class="mt-2 text-xs text-red-600 hidden">Por favor selecciona una puntuación</p>
            </div>

            <div>
                <label for="reviewComment" class="block text-sm font-semibold text-slate-950">Comentario (opcional)</label>
                <textarea id="reviewComment" name="comment" rows="3" placeholder="Comparte tu experiencia..." class="mt-3 w-full rounded-[16px] border border-slate-300 bg-white px-4 py-3 text-sm placeholder-slate-400 text-slate-900 transition focus:border-[#b41531] focus:outline-none focus:ring-2 focus:ring-[#f4d7dc] resize-none"></textarea>
            </div>

            <button type="submit" class="w-full rounded-full bg-[#b41531] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                Enviar reseña
            </button>
        </form>
    </div>
</div>

<script>
    let currentBookingId = null;

    function openReviewModal(bookingId, propertyName) {
        currentBookingId = bookingId;
        document.getElementById('reviewBookingId').value = bookingId;
        document.getElementById('reviewPropertyName').textContent = 'Reseña para: ' + propertyName;
        document.getElementById('reviewModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        document.getElementById('starError').classList.add('hidden');
        document.getElementById('reviewForm').querySelectorAll('input[name="rating"]').forEach(r => r.checked = false);
        document.getElementById('reviewComment').value = '';
    }

    function closeReviewModal() {
        document.getElementById('reviewModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.getElementById('reviewModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeReviewModal();
        }
    });

    document.getElementById('reviewForm').addEventListener('submit', function(e) {
        const rating = this.querySelector('input[name="rating"]:checked');
        if (!rating) {
            e.preventDefault();
            document.getElementById('starError').classList.remove('hidden');
            return;
        }
        const originalAction = '/BookingRenting/Booking/Review/' + currentBookingId;
        this.action = originalAction;
    });

    // Star rating hover effect
    document.querySelectorAll('.star-label').forEach(label => {
        label.addEventListener('mouseenter', function() {
            const value = parseInt(this.dataset.value);
            document.querySelectorAll('.star-label').forEach(l => {
                const lv = parseInt(l.dataset.value);
                if (lv <= value) {
                    l.classList.add('text-yellow-400');
                    l.classList.remove('text-slate-300');
                } else {
                    l.classList.remove('text-yellow-400');
                    l.classList.add('text-slate-300');
                }
            });
        });
        label.addEventListener('mouseleave', function() {
            const checked = document.querySelector('input[name="rating"]:checked');
            document.querySelectorAll('.star-label').forEach(l => {
                const lv = parseInt(l.dataset.value);
                if (checked) {
                    const cv = parseInt(checked.value);
                    if (lv <= cv) {
                        l.classList.add('text-yellow-400');
                        l.classList.remove('text-slate-300');
                    } else {
                        l.classList.remove('text-yellow-400');
                        l.classList.add('text-slate-300');
                    }
                } else {
                    l.classList.remove('text-yellow-400');
                    l.classList.add('text-slate-300');
                }
            });
        });
    });

    // When a star is selected, update colors
    document.querySelectorAll('input[name="rating"]').forEach(radio => {
        radio.addEventListener('change', function() {
            document.getElementById('starError').classList.add('hidden');
            const cv = parseInt(this.value);
            document.querySelectorAll('.star-label').forEach(l => {
                const lv = parseInt(l.dataset.value);
                if (lv <= cv) {
                    l.classList.add('text-yellow-400');
                    l.classList.remove('text-slate-300');
                } else {
                    l.classList.remove('text-yellow-400');
                    l.classList.add('text-slate-300');
                }
            });
        });
    });

    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const filter = this.dataset.filter;
            const cards = document.querySelectorAll('.booking-card');
            
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.remove('bg-[#b41531]', 'text-white');
                b.classList.add('bg-white', 'text-slate-700');
            });
            
            this.classList.remove('bg-white', 'text-slate-700');
            this.classList.add('bg-[#b41531]', 'text-white');
            
            cards.forEach(card => {
                if (filter === 'all' || card.dataset.status === filter) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });
</script>
