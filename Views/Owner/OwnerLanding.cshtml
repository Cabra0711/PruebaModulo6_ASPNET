@using System.Security.Claims
@model IEnumerable<RentingBooking.Models.Property>

@{
    ViewData["Title"] = "Mi panel de propietario";
    var properties = Model?.ToList() ?? new List<RentingBooking.Models.Property>();
    var currentUser = User.FindFirstValue(System.Security.Claims.ClaimTypes.Name) ?? "Propietario";
    
    var totalRevenue = properties.SelectMany(p => p.Bookings ?? new List<RentingBooking.Models.Booking>())
                                 .Where(b => b.CreatedAt.Month == DateTime.Now.Month && b.CreatedAt.Year == DateTime.Now.Year)
                                 .Sum(b => b.TotalPrice);
    
    var avgOccupancy = properties.Any() ? (decimal)properties.Average(p => 
        (p.Bookings?.Count(b => b.CheckInDate <= DateOnly.FromDateTime(DateTime.Now) && b.CheckOutDate >= DateOnly.FromDateTime(DateTime.Now)) ?? 0) * 100 / 30) : 0;
    
    var upcomingCheckIns = properties.SelectMany(p => p.Bookings ?? new List<RentingBooking.Models.Booking>())
                                      .Where(b => b.CheckInDate >= DateOnly.FromDateTime(DateTime.Now) && 
                                                  b.CheckInDate <= DateOnly.FromDateTime(DateTime.Now.AddDays(7)))
                                      .Count();
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-[#fff4f5] text-slate-900">
    <!-- Header -->
    <header class="border-b border-[#f4d7dc] bg-white/90 py-4 shadow-sm sticky top-0 z-50">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 text-[#b41531] font-semibold">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-[#fde3e8] text-xl">♥</span>
                <span class="text-lg">RentingBooking</span>
            </a>
            <div class="flex items-center gap-4">
                <a href="#" class="text-sm font-medium text-slate-600 transition hover:text-[#b41531]">
                    Explore
                </a>
                <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#fde3e8] text-[#b41531] transition hover:bg-[#f4d7dc]">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 12C13.1 12 14 11.1 14 10C14 8.9 13.1 8 12 8C10.9 8 10 8.9 10 10C10 11.1 10.9 12 12 12ZM12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        @if (TempData["ErrorMessage"] != null || TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 rounded-[28px] border px-6 py-4 text-sm shadow-sm"
                 style="border-color:#f4d7dc; background:#fff1f3; color:#7d141f;">
                @if (TempData["ErrorMessage"] != null)
                {
                    <p>@TempData["ErrorMessage"]</p>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <p>@TempData["SuccessMessage"]</p>
                }
            </div>
        }

        <!-- Welcome Section -->
        <div class="mb-8 rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm sm:p-8">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500">Propietario</p>
            <h1 class="mt-2 text-4xl font-bold text-slate-950">¡Hola, @currentUser!</h1>
            <p class="mt-3 max-w-xl text-slate-600">Gestiona tus alojamientos y maximiza tus ingresos con nuestras herramientas de análisis avanzadas.</p>
            
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:gap-4">
                <a asp-controller="Owner" asp-action="OwnerDashboard" class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-[#b41531] hover:text-[#b41531]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3 13H11V3H3V13ZM13 21H21V11H13V21ZM13 3V9H21V3H13ZM3 15H9V21H3V15Z" />
                    </svg>
                    Ver Dashboard analítico
                </a>
                <a asp-controller="Property" asp-action="CreateProperty" class="inline-flex items-center justify-center gap-2 rounded-full bg-[#b41531] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                    </svg>
                    Nueva propiedad
                </a>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="mb-8 grid gap-6 sm:grid-cols-3">
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
                <p class="text-xs uppercase tracking-[0.3em] text-slate-500">Ingresos este mes</p>
                <p class="mt-3 text-3xl font-bold text-slate-950">@totalRevenue.ToString("C")</p>
                <p class="mt-2 text-sm text-green-600">↑ +38% vs mes anterior</p>
            </div>
            
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
                <p class="text-xs uppercase tracking-[0.3em] text-slate-500">Ocupación media</p>
                <p class="mt-3 text-3xl font-bold text-slate-950">@avgOccupancy.ToString("F0")%</p>
                <div class="mt-3 h-2 rounded-full bg-[#f4d7dc]">
                    <div class="h-full rounded-full bg-[#b41531]" style="width: @avgOccupancy%"></div>
                </div>
            </div>
            
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
                <p class="text-xs uppercase tracking-[0.3em] text-slate-500">Próximas llegadas</p>
                <p class="mt-3 text-3xl font-bold text-slate-950">@upcomingCheckIns Check-ins</p>
                <p class="mt-2 text-sm text-slate-600">Para los próximos 7 días</p>
            </div>
        </div>

        <!-- Properties Section -->
        <div class="mb-6 flex items-center justify-between rounded-[24px] border border-[#f4d7dc] bg-white p-4 shadow-sm">
            <h2 class="text-xl font-bold text-slate-950">Tus propiedades</h2>
            <div class="flex gap-2">
                <button type="button" id="gridViewBtn" class="inline-flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#fff4f5] text-[#b41531] transition hover:bg-[#f4d7dc]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3 3H10V10H3V3ZM14 3H21V10H14V3ZM14 14H21V21H14V14ZM3 14H10V21H3V14Z" />
                    </svg>
                </button>
                <button type="button" id="listViewBtn" class="inline-flex h-10 w-10 items-center justify-center rounded-[12px] text-slate-600 transition hover:bg-[#f4d7dc] hover:text-[#b41531]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3 4H21V6H3V4ZM3 11H21V13H3V11ZM3 18H21V20H3V18Z" />
                    </svg>
                </button>
            </div>
        </div>

        @if (!properties.Any())
        {
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-8 text-center shadow-sm">
                <svg class="mx-auto h-16 w-16 text-[#f4d7dc]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9L12 2L21 9V20C21 21.1 20.1 22 19 22H5C3.9 22 3 21.1 3 20V9Z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                <h3 class="mt-4 text-lg font-semibold text-slate-950">No tienes propiedades aún</h3>
                <p class="mt-2 text-sm text-slate-600">Comienza a hospedar creando tu primera propiedad.</p>
                <a asp-controller="Property" asp-action="CreateProperty" class="mt-6 inline-flex rounded-full bg-[#b41531] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                    Crear propiedad
                </a>
            </div>
        }
        else
        {
            <div id="gridContainer" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var property in properties)
                {
                    var isActive = property.IsActive == true;
                    var statusLabel = isActive ? "Activa" : "En revisión";
                    var statusColor = isActive ? "bg-[#1f7a43] text-white" : "bg-[#fde3e8] text-[#b41531]";
                    var upcomingBookings = property.Bookings?.Where(b => b.CheckInDate >= DateOnly.FromDateTime(DateTime.Now)).Count() ?? 0;

                    <div class="property-card rounded-[32px] border border-[#f4d7dc] bg-white shadow-sm overflow-hidden transition hover:shadow-md">
                        <div class="relative overflow-hidden rounded-t-[32px] bg-slate-200 h-48">
                            <img src="@(property.Images?.FirstOrDefault()?.Url ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=500&q=80")" alt="@property.Title" class="h-full w-full object-cover" />
                            <span class="absolute top-4 right-4 inline-flex items-center gap-1 rounded-full @statusColor px-3 py-1.5 text-xs font-semibold">
                                ● @statusLabel
                            </span>
                            <div class="absolute top-4 left-4 flex gap-2">
                                <a asp-controller="Property" asp-action="UpdateProperty" asp-route-id="@property.Id" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white text-slate-600 shadow-md transition hover:text-[#b41531]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4C2.9 4 2 4.9 2 6V20C2 21.1 2.9 22 4 22H18C19.1 22 20 21.1 20 20V13" />
                                        <path d="M18.5 2.5C19.3 1.7 20.7 1.7 21.5 2.5C22.3 3.3 22.3 4.7 21.5 5.5L7 20H4V17L18.5 2.5Z" />
                                    </svg>
                                </a>
                                <form asp-controller="Property" asp-action="DeleteProperty" asp-route-id="@property.Id" method="post" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta propiedad?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white text-slate-600 shadow-md transition hover:text-red-600">
                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6V20C19 21.1 18.1 22 17 22H7C5.9 22 5 21.1 5 20V6M8 6V4C8 2.9 8.9 2 10 2H14C15.1 2 16 2.9 16 4V6" />
                                            <line x1="10" y1="11" x2="10" y2="17" />
                                            <line x1="14" y1="11" x2="14" y2="17" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="p-5 sm:p-6">
                            <h3 class="text-lg font-semibold text-slate-950">@property.Title</h3>
                            <div class="mt-2 flex items-center gap-2 text-sm text-slate-600">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                                </svg>
                                @property.Location
                            </div>

                            <div class="mt-4 border-t border-[#f4d7dc] pt-4">
                                <p class="text-sm text-slate-600">Precio por noche</p>
                                <p class="mt-2 text-2xl font-bold text-[#b41531]">@property.PricePerNight.ToString("C")</p>
                            </div>

                            <div class="mt-4 flex gap-3">
                                <a asp-controller="Booking" asp-action="PropertyBookings" asp-route-propertyId="@property.Id" class="flex-1 rounded-full border border-[#b41531] px-4 py-2 text-center text-sm font-semibold text-[#b41531] transition hover:bg-[#fde3e8]">
                                    Ver reservas →
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div id="listContainer" style="display:none;" class="space-y-4">
                @foreach (var property in properties)
                {
                    var isActive = property.IsActive == true;
                    var statusLabel = isActive ? "Activa" : "En revisión";
                    var statusColor = isActive ? "bg-[#1f7a43] text-white" : "bg-[#fde3e8] text-[#b41531]";

                    <div class="property-card rounded-[24px] border border-[#f4d7dc] bg-white p-6 shadow-sm">
                        <div class="flex gap-6">
                            <img src="@(property.Images?.FirstOrDefault()?.Url ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=200&q=80")" alt="@property.Title" class="h-32 w-40 rounded-[16px] object-cover" />
                            <div class="flex-1">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <h3 class="text-lg font-semibold text-slate-950">@property.Title</h3>
                                        <div class="mt-1 flex items-center gap-2 text-sm text-slate-600">
                                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                                            </svg>
                                            @property.Location
                                        </div>
                                    </div>
                                    <span class="inline-flex items-center gap-1 rounded-full @statusColor px-3 py-1.5 text-xs font-semibold">
                                        ● @statusLabel
                                    </span>
                                </div>
                                <p class="mt-4 text-2xl font-bold text-[#b41531]">@property.PricePerNight.ToString("C")<span class="text-sm text-slate-600"> /noche</span></p>
                                <div class="mt-4 flex gap-3">
                                    <a asp-controller="Property" asp-action="UpdateProperty" asp-route-id="@property.Id" class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#b41531] hover:text-[#b41531]">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4C2.9 4 2 4.9 2 6V20C2 21.1 2.9 22 4 22H18C19.1 22 20 21.1 20 20V13" />
                                            <path d="M18.5 2.5C19.3 1.7 20.7 1.7 21.5 2.5C22.3 3.3 22.3 4.7 21.5 5.5L7 20H4V17L18.5 2.5Z" />
                                        </svg>
                                        Editar
                                    </a>
                                    <a asp-controller="Booking" asp-action="PropertyBookings" asp-route-propertyId="@property.Id" class="inline-flex items-center gap-2 rounded-full border border-[#b41531] px-4 py-2 text-sm font-semibold text-[#b41531] transition hover:bg-[#fde3e8]">
                                        Ver reservas →
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#f4d7dc] bg-[#fff4f5] py-8 px-4 text-center text-sm text-slate-600 sm:px-6 lg:px-8 mb-20 md:mb-0">
        <div class="mx-auto max-w-7xl">
            <p class="font-semibold text-[#b41531]">RentingBooking</p>
            <p class="mt-2">© 2024 RentingBooking Inc.</p>
            <div class="mt-4 flex flex-wrap justify-center gap-4">
                <a href="#" class="transition hover:text-[#b41531]">Privacy</a>
                <a href="#" class="transition hover:text-[#b41531]">Terms</a>
                <a href="#" class="transition hover:text-[#b41531]">Sitemap</a>
            </div>
        </div>
    </footer>
</div>

<script>
    document.getElementById('gridViewBtn').addEventListener('click', function() {
        document.getElementById('gridContainer').style.display = 'grid';
        document.getElementById('listContainer').style.display = 'none';
        this.classList.add('bg-[#fff4f5]', 'text-[#b41531]');
        this.classList.remove('bg-white', 'text-slate-600');
        document.getElementById('listViewBtn').classList.remove('bg-[#fff4f5]', 'text-[#b41531]');
        document.getElementById('listViewBtn').classList.add('text-slate-600');
    });

    document.getElementById('listViewBtn').addEventListener('click', function() {
        document.getElementById('gridContainer').style.display = 'none';
        document.getElementById('listContainer').style.display = 'block';
        this.classList.add('bg-[#fff4f5]', 'text-[#b41531]');
        document.getElementById('gridViewBtn').classList.remove('bg-[#fff4f5]', 'text-[#b41531]');
        document.getElementById('gridViewBtn').classList.add('bg-white', 'text-slate-600');
    });
</script>
