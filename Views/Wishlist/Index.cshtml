@model IEnumerable<RentingBooking.Models.WishListItem>

@{
    ViewData["Title"] = "Mi lista de deseos";
    var wishlistItems = Model?.ToList() ?? new List<RentingBooking.Models.WishListItem>();
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-[#fff4f5] text-slate-900">
    <!-- Header -->
    <header class="border-b border-[#f4d7dc] bg-white/90 py-4 shadow-sm sticky top-0 z-50">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 text-[#b41531] font-semibold">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-[#fde3e8] text-xl">♥</span>
                <span class="text-lg">RentingBooking</span>
            </a>
            <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#fde3e8] text-[#b41531] transition hover:bg-[#f4d7dc] sm:hidden">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
            </button>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 pb-28 sm:pb-8">
        @if (!isAuthenticated)
        {
            <!-- Not Authenticated View -->
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-8 text-center shadow-sm">
                <svg class="mx-auto h-16 w-16 text-[#f4d7dc]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" />
                </svg>
                <h2 class="mt-4 text-2xl font-bold text-slate-950">Mi lista de deseos</h2>
                <p class="mt-2 text-slate-600">Inicia sesión para guardar tus propiedades favoritas y acceder a tu lista de deseos.</p>
                <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center sm:gap-4">
                    <a asp-controller="Auth" asp-action="Login" class="inline-flex items-center justify-center rounded-full bg-[#b41531] px-8 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                        Iniciar sesión
                    </a>
                    <a asp-controller="Auth" asp-action="Login" asp-route-tab="register" class="inline-flex items-center justify-center rounded-full border border-[#b41531] px-8 py-3 text-sm font-semibold text-[#b41531] transition hover:bg-[#fde3e8]">
                        Registrarse
                    </a>
                </div>
            </div>
        }
        else if (!wishlistItems.Any())
        {
            <!-- Empty Wishlist View -->
            <div class="rounded-[32px] border border-[#f4d7dc] bg-white p-8 text-center shadow-sm">
                <svg class="mx-auto h-16 w-16 text-[#f4d7dc]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" />
                </svg>
                <h2 class="mt-4 text-2xl font-bold text-slate-950">Tu lista de deseos está vacía</h2>
                <p class="mt-2 text-slate-600">Empieza a añadir propiedades que te gusten.</p>
                <a asp-controller="Property" asp-action="GetPublicProperties" class="mt-6 inline-flex rounded-full bg-[#b41531] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#991a30]">
                    Explorar propiedades
                </a>
            </div>
        }
        else
        {
            <!-- Wishlist Header -->
            <div class="mb-8">
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-12 w-12 items-center justify-center rounded-[16px] bg-[#b41531] text-2xl text-white">♥</span>
                    <h1 class="text-3xl font-bold text-slate-950">Mi lista de deseos</h1>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null || TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 rounded-[28px] border px-6 py-4 text-sm shadow-sm"
                     style="border-color:#f4d7dc; background:#fff1f3; color:#7d141f;">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <p>@TempData["ErrorMessage"]</p>
                    }
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <p>@TempData["SuccessMessage"]</p>
                    }
                </div>
            }

            <!-- Wishlist Cards -->
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var item in wishlistItems)
                {
                    <div class="rounded-[32px] border border-[#f4d7dc] bg-white shadow-sm overflow-hidden transition hover:shadow-md">
                        <div class="relative overflow-hidden rounded-t-[32px] bg-slate-200 h-48">
                            <img src="@(item.Property?.Images?.FirstOrDefault()?.Url ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=600&q=80")" alt="@item.Property?.Title" class="h-full w-full object-cover" />
                            <form asp-controller="Wishlist" asp-action="Remove" asp-route-propertyId="@item.PropertyId" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="absolute top-4 right-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#b41531] shadow-md transition hover:bg-[#fde3e8]">
                                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" />
                                    </svg>
                                </button>
                            </form>
                        </div>

                        <div class="p-5 sm:p-6">
                            <div class="flex items-start justify-between gap-2">
                                <h3 class="text-lg font-semibold text-slate-950 flex-1">@item.Property?.Title</h3>
                                @if (item.Property != null)
                                {
                                    <div class="flex items-center gap-1 text-sm">
                                        <span class="text-slate-500">@item.Property.Location</span>
                                    </div>
                                }
                            </div>

                            <div class="mt-2 flex items-center gap-2 text-sm text-slate-600">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" />
                                </svg>
                                @item.Property?.Location
                            </div>

                            <div class="mt-4 border-t border-[#f4d7dc] pt-4">
                                <p class="text-sm text-slate-600">Precio por noche</p>
                                <p class="mt-2 text-2xl font-bold text-[#b41531]">@item.Property?.PricePerNight.ToString("C")</p>
                            </div>

                            <div class="mt-4 flex gap-3">
                                <a asp-controller="Booking" asp-action="CreateBooking" asp-route-propertyId="@item.PropertyId" class="flex-1 rounded-full bg-[#b41531] px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-[#991a30]">
                                    Ver / Reservar
                                </a>
                                <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 text-slate-600 transition hover:border-[#b41531] hover:text-[#b41531]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 12a8 8 0 0 0 8 8a8 8 0 0 0 8-8" />
                                        <path d="M12 2v8" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#f4d7dc] bg-[#fff4f5] py-8 px-4 text-center text-sm text-slate-600 sm:px-6 lg:px-8 mt-8 mb-20 md:mb-0">
        <div class="mx-auto max-w-7xl">
            <p class="font-semibold text-[#b41531]">RentingBooking</p>
            <p class="mt-2">© 2024 RentingBooking Inc.</p>
            <div class="mt-4 flex flex-wrap justify-center gap-4">
                <a href="#" class="transition hover:text-[#b41531]">Privacy</a>
                <a href="#" class="transition hover:text-[#b41531]">Terms</a>
                <a href="#" class="transition hover:text-[#b41531]">Sitemap</a>
                <a href="#" class="transition hover:text-[#b41531]">Destinations</a>
            </div>
        </div>
    </footer>
</div>
