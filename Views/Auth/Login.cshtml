@model RentingBooking.Models.User

@{
    ViewData["Title"] = "Iniciar sesión";
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-[#fff4f5] flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-2xl">
        <div class="rounded-[32px] bg-white shadow-[0_40px_120px_rgba(0,0,0,0.1)] overflow-hidden">
            <div class="bg-[#fff1f3] px-8 py-6 flex items-center gap-4 border-b border-[#f4d7dc]">
                <div class="flex h-14 w-14 items-center justify-center rounded-3xl bg-[#f5d9e0] text-[#b41531]">
                    <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 7.5C4 6.11929 5.11929 5 6.5 5H17.5C18.8807 5 20 6.11929 20 7.5V16.5C20 17.8807 18.8807 19 17.5 19H6.5C5.11929 19 4 17.8807 4 16.5V7.5Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M8 11H16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        <path d="M8 14H12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#b41531]">RentingBooking</p>
                    <h1 class="mt-2 text-3xl font-semibold text-slate-900">Iniciar sesión</h1>
                </div>
            </div>

            <div class="px-8 py-8 sm:px-12">
                <div class="grid grid-cols-2 gap-4 mb-8 rounded-[18px] border border-[#f4d7dc] bg-white p-1 shadow-sm">
                    <button id="loginTab" type="button" class="rounded-[16px] bg-[#b41531] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#9c1227]">Iniciar sesión</button>
                    <button id="registerTab" type="button" class="rounded-[16px] bg-transparent px-4 py-3 text-sm font-semibold text-[#5f5f5f] transition hover:bg-[#f7ebee]">Registrarse</button>
                </div>

                @if (TempData["ErrorMessage"] != null || ViewBag.Error != null || ViewBag.ErrorValidation != null)
                {
                    <div class="mb-6 rounded-3xl border border-[#f7d2d8] bg-[#fff1f3] p-4 text-sm text-[#7d141f]">
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <p>@TempData["ErrorMessage"]</p>
                        }
                        @if (ViewBag.Error != null)
                        {
                            <p>@ViewBag.Error</p>
                        }
                        @if (ViewBag.ErrorValidation != null)
                        {
                            @Html.Raw(ViewBag.ErrorValidation)
                        }
                    </div>
                }

                @if (TempData["SuccessMessage"] != null || ViewBag.Success != null)
                {
                    <div class="mb-6 rounded-3xl border border-[#dce7f4] bg-[#eff6ff] p-4 text-sm text-[#0f4f8f]">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <p>@TempData["SuccessMessage"]</p>
                        }
                        @if (ViewBag.Success != null)
                        {
                            <p>@ViewBag.Success</p>
                        }
                    </div>
                }

                <div id="loginPanel">
                    <form asp-action="Login" asp-controller="Auth" method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <div class="space-y-3">
                            <label for="username" class="text-sm font-medium text-slate-700">Usuario</label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[#b41531]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M16 21V19C16 17.3431 14.6569 16 13 16H11C9.34315 16 8 17.3431 8 19V21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                                <input id="username" name="username" type="text" required class="w-full rounded-[20px] border border-[#e9d6dc] bg-[#fff6f8] py-4 pl-12 pr-4 text-sm text-slate-900 outline-none transition focus:border-[#b41531] focus:ring-2 focus:ring-[#f8d8de]" placeholder="Tu nombre de usuario" />
                            </div>
                        </div>

                        <div class="space-y-3">
                            <label for="password" class="text-sm font-medium text-slate-700">Contraseña</label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[#b41531]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect x="6" y="11" width="12" height="8" rx="3" stroke="currentColor" stroke-width="1.6"/>
                                        <path d="M9 11V8C9 6.34315 10.3431 5 12 5C13.6569 5 15 6.34315 15 8V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <input id="password" name="password" type="password" required class="w-full rounded-[20px] border border-[#e9d6dc] bg-[#fff6f8] py-4 pl-12 pr-4 text-sm text-slate-900 outline-none transition focus:border-[#b41531] focus:ring-2 focus:ring-[#f8d8de]" placeholder="Tu contraseña" />
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-sm text-slate-600">
                            <div></div>
                            <a href="#" class="font-medium text-[#b41531] hover:text-[#8f1025]">¿Olvidaste tu contraseña?</a>
                        </div>

                        <button type="submit" class="w-full rounded-[22px] bg-[#b41531] px-6 py-4 text-sm font-semibold text-white shadow-[0_16px_30px_rgba(180,21,49,0.25)] transition hover:bg-[#9c1227]">Entrar</button>
                    </form>
                </div>

                <div id="registerPanel" class="hidden">
                    <form id="registerForm" asp-action="RegisterCustomer" asp-controller="Auth" method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <div class="rounded-2xl border border-[#f4d7dc] bg-[#fef7f8] p-4 text-sm text-[#85333b]" id="ownerAlert" style="display:none;">
                            Estás registrando como <strong>propietario</strong>. Completa tus datos para crear tu perfil de anfitrión.
                        </div>
                        <div class="space-y-3">
                            <label for="regUsername" class="text-sm font-medium text-slate-700">Nombre de usuario</label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[#b41531]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M16 21V19C16 17.3431 14.6569 16 13 16H11C9.34315 16 8 17.3431 8 19V21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                                <input id="regUsername" asp-for="Username" type="text" class="w-full rounded-[20px] border border-[#e9d6dc] bg-[#fff6f8] py-4 pl-12 pr-4 text-sm text-slate-900 outline-none transition focus:border-[#b41531] focus:ring-2 focus:ring-[#f8d8de]" placeholder="Tu nombre de usuario" />
                            </div>
                        </div>

                        <div class="space-y-3">
                            <label for="regEmail" class="text-sm font-medium text-slate-700">Correo electrónico</label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[#b41531]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M4 7.5L12 13.5L20 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M4 7.5V16.5C4 17.3284 4.67157 18 5.5 18H18.5C19.3284 18 20 17.3284 20 16.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                                <input id="regEmail" asp-for="Email" type="email" class="w-full rounded-[20px] border border-[#e9d6dc] bg-[#fff6f8] py-4 pl-12 pr-4 text-sm text-slate-900 outline-none transition focus:border-[#b41531] focus:ring-2 focus:ring-[#f8d8de]" placeholder="Tu correo electrónico" />
                            </div>
                        </div>

                        <div class="space-y-3">
                            <label for="regPassword" class="text-sm font-medium text-slate-700">Contraseña</label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[#b41531]">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect x="6" y="11" width="12" height="8" rx="3" stroke="currentColor" stroke-width="1.6"/>
                                        <path d="M9 11V8C9 6.34315 10.3431 5 12 5C13.6569 5 15 6.34315 15 8V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <input id="regPassword" asp-for="PasswordHash" type="password" class="w-full rounded-[20px] border border-[#e9d6dc] bg-[#fff6f8] py-4 pl-12 pr-4 text-sm text-slate-900 outline-none transition focus:border-[#b41531] focus:ring-2 focus:ring-[#f8d8de]" placeholder="Tu contraseña" />
                            </div>
                        </div>

                        <button id="registerButton" type="submit" class="w-full rounded-[22px] bg-[#b41531] px-6 py-4 text-sm font-semibold text-white shadow-[0_16px_30px_rgba(180,21,49,0.25)] transition hover:bg-[#9c1227]">Crear cuenta</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const loginTab = document.getElementById('loginTab');
        const registerTab = document.getElementById('registerTab');
        const loginPanel = document.getElementById('loginPanel');
        const registerPanel = document.getElementById('registerPanel');
        const registerForm = document.getElementById('registerForm');
        const ownerAlert = document.getElementById('ownerAlert');
        const registerButton = document.getElementById('registerButton');

        function switchTab(active) {
            if (active === 'login') {
                loginTab.classList.add('bg-[#b41531]','text-white');
                loginTab.classList.remove('bg-transparent','text-[#5f5f5f]');
                registerTab.classList.add('bg-transparent','text-[#5f5f5f]');
                registerTab.classList.remove('bg-[#b41531]','text-white');
                registerPanel.classList.add('hidden');
                loginPanel.classList.remove('hidden');
            } else {
                registerTab.classList.add('bg-[#b41531]','text-white');
                registerTab.classList.remove('bg-transparent','text-[#5f5f5f]');
                loginTab.classList.add('bg-transparent','text-[#5f5f5f]');
                loginTab.classList.remove('bg-[#b41531]','text-white');
                loginPanel.classList.add('hidden');
                registerPanel.classList.remove('hidden');
            }
        }

        function setRegisterMode(mode) {
            if (mode === 'owner') {
                registerForm.action = '/BookingRenting/RegisterOwner';
                registerButton.textContent = 'Crear cuenta de propietario';
                ownerAlert.style.display = 'block';
            } else {
                registerForm.action = '/BookingRenting/RegisterCustomer';
                registerButton.textContent = 'Crear cuenta';
                ownerAlert.style.display = 'none';
            }
        }

        loginTab.addEventListener('click', () => {
            switchTab('login');
            setRegisterMode('customer');
        });
        registerTab.addEventListener('click', () => {
            switchTab('register');
            setRegisterMode('customer');
        });

        const params = new URLSearchParams(window.location.search);
        if (params.get('tab') === 'owner') {
            switchTab('register');
            setRegisterMode('owner');
        }
    </script>
}
